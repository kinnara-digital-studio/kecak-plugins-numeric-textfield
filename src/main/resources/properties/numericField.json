[
  {
    "title": "@@form.numericfield.editNumericField@@",
    "properties": [
      {
        "name": "id",
        "label": "@@form.numericfield.id@@",
        "type": "textfield",
        "required": "True",
        "regex_validation": "^[a-zA-Z0-9_]+$",
        "validation_message": "@@form.numericfield.invalidId@@"
      },
      {
        "name": "label",
        "label": "@@form.numericfield.label@@",
        "type": "textfield",
        "value": "Numeric Field"
      },
      {
        "name": "variables",
        "label": "@@form.numericfield.variables@@",
        "description": "@@form.numericfield.variables.desc@@",
        "type": "grid",
        "columns": [
          {
            "key": "variableName",
            "label": "@@form.numericfield.fieldId@@",
            "required": "true"
          },
          {
            "key": "operation",
            "label": "@@form.numericfield.multivalueOperation@@",
            "options": [
              {
                "value": "sum",
                "label": "@@form.numericfield.multivalueOperation.sum@@"
              },
              {
                "value": "avg",
                "label": "@@form.numericfield.multivalueOperation.avg@@"
              },
              {
                "value": "min",
                "label": "@@form.numericfield.multivalueOperation.min@@"
              },
              {
                "value": "max",
                "label": "@@form.numericfield.multivalueOperation.max@@"
              },
              {
                "value": "count",
                "label": "@@form.numericfield.multivalueOperation.count@@"
              },
              {
                "value": "text",
                "label": "@@form.numericfield.multivalueOperation.text@@"
              }
            ]
          }
        ]
      },
      {
        "name": "calculationLoadBinder",
        "label": "@@form.numericfield.calculationLoadBinder@@",
        "description": "@@form.numericfield.calculationLoadBinder.desc@@",
        "type": "elementselect",
        "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.form.model.FormLoadElementBinder",
        "value": "%s",
        "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions"
      },
      {
        "name": "useJsEquation",
        "label": "Use Simple Javascript Equation?",
        "description": "Using javascript equation instead of using Ajax",
        "type": "radio",
        "value": "",
        "options": [
          {
            "value": "",
            "label": "No"
          },
          {
            "value": "true",
            "label": "Simple"
          },
          {
            "value": "multiline",
            "label": "Multi-Line Javascript"
          }
        ]
      },
      {
        "name": "jsEquation",
        "label": "Equation",
        "type": "textfield",
        "control_field": "useJsEquation",
        "control_value": "true"
      },
      {
        "name": "roundNumber",
        "label": "Round Number?",
        "type": "checkbox",
        "value": "",
        "options": [
          {
            "value": "true",
            "label": ""
          }
        ]
      },
      {
        "name": "roundingMode",
        "label": "Rounding Mode",
        "type": "selectbox",
        "control_field": "roundNumber",
        "control_value": "true",
        "options": [
          {
            "value": "round_down",
            "label": "Round Down (Floor)"
          },
          {
            "value": "round_up",
            "label": "Round Up (Ceiling)"
          },
          {
            "value": "round_half_up",
            "label": "Mathematical Standard (ISO 80000-1)"
          }
        ],
        "value": "ROUND_DOWN",
        "required": "true"
      },
      {
        "name": "decimalPlaces",
        "label": "Decimal Places",
        "type": "textfield",
        "value": "0",
        "control_field": "roundNumber",
        "control_value": "true",
        "regex_validation": "^[0-9]+$",
        "validation_message": "Please enter a valid positive number.",
        "description": "0 for integers, 2 for currency, etc."
      },
      {
        "name": "multilineJs",
        "label": "Multi-Line Javascript",
        "type": "codeeditor",
        "mode": "javascript",
        "control_field": "useJsEquation",
        "control_value": "multiline",
        "required": "true"
      },
      {
        "name": "calculatorCheckBox",
        "label": "Calculator",
        "type": "checkbox",
        "value": "",
        "options": [
          {
            "value": "true",
            "label": ""
          }
        ]
      }
    ]
  },
  {
    "title": "@@form.numericfield.advancedOptions@@",
    "properties": [
      {
        "label": "@@form.numericfield.data@@",
        "type": "header"
      },
      {
        "name": "validator",
        "label": "@@form.numericfield.validator@@",
        "type": "elementselect",
        "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.form.model.FormValidator",
        "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions"
      },
      {
        "label": "@@form.numericfield.format@@",
        "type": "header"
      },
      {
        "name": "formatterPlugin",
        "label": "@@form.numericfield.formatterPlugin@@",
        "description": "@@form.numericfield.formatter.desc@@",
        "type": "elementselect",
        "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.datalist.model.DataListColumnFormatDefault",
        "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions"
      },
      {
        "name": "currencyRefField",
        "label": "@@form.numericfield.currencyRefField@@",
        "type": "textfield"
      },
      {
        "label": "@@form.numericfield.ui@@",
        "type": "header"
      },
      {
        "name": "hidden",
        "label": "@@form.numericfield.hidden@@",
        "type": "checkbox",
        "options": [
          {
            "value": "true",
            "label": ""
          }
        ]
      },
      {
        "name": "readonly",
        "label": "@@form.numericfield.readonly@@",
        "type": "checkbox",
        "options": [
          {
            "value": "true",
            "label": ""
          }
        ]
      },
      {
        "name": "readonlyLabel",
        "label": "@@form.numericfield.readonlyLabel@@",
        "type": "checkbox",
        "options": [
          {
            "value": "true",
            "label": ""
          }
        ]
      },
      {
        "label": "Spelling",
        "type": "header"
      },
      {
        "name": "language",
        "label": "@@form.numericfield.language@@",
        "required": "true",
        "type": "radio",
        "value": "id",
        "description": "@@form.numericfield.language.description@@",
        "options": [
          {
            "value": "id",
            "label": "@@form.numericfield.language.id@@"
          }
        ]
      },
      {
        "name": "spellingTarget",
        "label": "@@form.numericfield.language.target@@",
        "description": "@@form.numericfield.language.target.desc@@",
        "type": "textfield"
      },
      {
        "label": "@@form.numericfield.workflow@@",
        "type": "header"
      },
      {
        "name": "workflowVariable",
        "label": "@@form.numericfield.workflowVariable@@",
        "type": "textfield"
      },
      {
        "label": "Control Field",
        "type": "header"
      },
      {
        "name": "controlField",
        "label": "Control Field",
        "type": "grid",
        "columns": [
            {
              "key": "fieldId",
              "label": "Field ID"
            },
            {
              "key": "reverseValue",
              "label": "Reverse Value",
              "type": "truefalse",
              "false_value": ""
            },
            {
              "key": "fieldValue",
              "label": "Field Value"
            }
        ]
      }
    ]
  }
]